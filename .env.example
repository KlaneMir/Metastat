# Copy this file as .env (next to pyproject.toml or next to Metastat.exe). The .env file never goes into the repository.
# All values are optional.

# Demo mode: made-up Facebook pages, Instagram accounts and posts, no connection to Meta (true / false).
DEMO=false

# System user token from Business Manager (expiry: Never). Usually you paste it in the program:
# Settings → Add Meta connection. If you put it here, the program takes it over
# on the first start and stores it encrypted by Windows (DPAPI); remove it from this file afterwards.
META_SYSTEM_USER_TOKEN=

# A different data folder (connections, databases, images, reports). Empty = the default.
METASTAT_DATA=
